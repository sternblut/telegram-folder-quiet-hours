diff --git a/submodules/TelegramCore/Tests/ChatListFiltersInclusionTests.swift b/submodules/TelegramCore/Tests/ChatListFiltersInclusionTests.swift
new file mode 100644
index 00000000..a135746e
--- /dev/null
+++ b/submodules/TelegramCore/Tests/ChatListFiltersInclusionTests.swift
@@ -0,0 +1,135 @@
+import XCTest
+import Postbox
+@testable import TelegramCore
+
+/// Which chats a folder's quiet hours silence: the chats the folder shows, by its own rules (chat types, included,
+/// excluded and pinned chats, archived chats), except that being muted or read does not take a chat out.
+final class ChatListFiltersInclusionTests: XCTestCase {
+    private let accountPeerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(1))
+
+    private func user(_ id: Int64, bot: Bool = false) -> EnginePeer {
+        return EnginePeer(TelegramUser(
+            id: PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(id)),
+            accessHash: nil, firstName: "User", lastName: nil, username: nil, phone: nil, photo: [],
+            botInfo: bot ? BotUserInfo(flags: [], inlinePlaceholder: nil) : nil, restrictionInfo: nil, flags: [], emojiStatus: nil, usernames: [],
+            storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil,
+            profileBackgroundEmojiId: nil, subscriberCount: nil, verificationIconFileId: nil
+        ))
+    }
+
+    private func group(_ id: Int64) -> EnginePeer {
+        return EnginePeer(TelegramGroup(id: PeerId(namespace: Namespaces.Peer.CloudGroup, id: PeerId.Id._internalFromInt64Value(id)), title: "Group", photo: [], participantCount: 3, role: .member, membership: .Member, flags: [], defaultBannedRights: nil, migrationReference: nil, creationDate: 0, version: 0))
+    }
+
+    private func channel(_ id: Int64) -> EnginePeer {
+        return EnginePeer(TelegramChannel(id: PeerId(namespace: Namespaces.Peer.CloudChannel, id: PeerId.Id._internalFromInt64Value(id)), accessHash: nil, title: "Channel", username: nil, photo: [], creationDate: 0, version: 0, participationStatus: .member, info: .broadcast(TelegramChannelBroadcastInfo(flags: [])), flags: [], restrictionInfo: nil, adminRights: nil, bannedRights: nil, defaultBannedRights: nil, usernames: [], storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil, profileBackgroundEmojiId: nil, emojiStatus: nil, approximateBoostLevel: nil, subscriptionUntilDate: nil, verificationIconFileId: nil, sendPaidMessageStars: nil, linkedMonoforumId: nil))
+    }
+
+    private func secretChat(_ id: Int64, with user: EnginePeer) -> EnginePeer {
+        return EnginePeer(TelegramSecretChat(id: PeerId(namespace: Namespaces.Peer.SecretChat, id: PeerId.Id._internalFromInt64Value(id)), creationDate: 0, regularPeerId: user.id, accessHash: 0, role: .creator, embeddedState: .active, messageAutoremoveTimeout: nil))
+    }
+
+    private func folder(_ categories: ChatListFilterPeerCategories, id: Int32 = 2, include: [EnginePeer] = [], exclude: [EnginePeer] = [], pinned: [EnginePeer] = [], excludeMuted: Bool = false, excludeRead: Bool = false, excludeArchived: Bool = false) -> ChatListFilter {
+        var includePeers = ChatListFilterIncludePeers()
+        for peer in include {
+            let _ = includePeers.addPeer(peer.id)
+        }
+        for peer in pinned {
+            let _ = includePeers.addPinnedPeer(peer.id)
+        }
+        return .filter(id: id, title: ChatFolderTitle(text: "Folder", entities: [], enableAnimations: false), emoticon: nil, data: ChatListFilterData(
+            isShared: false, hasSharedLinks: false, categories: categories, excludeMuted: excludeMuted, excludeRead: excludeRead,
+            excludeArchived: excludeArchived, includePeers: includePeers, excludePeers: exclude.map(\.id), color: nil
+        ))
+    }
+
+    private func isQuiet(_ peer: EnginePeer, in filters: [ChatListFilter], groupId: EngineChatList.Group? = .root, isContact: Bool = false) -> Bool {
+        return ChatListFiltersInclusion(filters: filters, accountPeerId: self.accountPeerId).includes(peer: peer, groupId: groupId, isContact: isContact)
+    }
+
+    func testChatTypes() {
+        let contact = self.user(10)
+        let stranger = self.user(11)
+        let bot = self.user(12, bot: true)
+        let group = self.group(20)
+        let channel = self.channel(30)
+        let groups = self.folder(.groups)
+        XCTAssertTrue(self.isQuiet(group, in: [groups]))
+        XCTAssertFalse(self.isQuiet(channel, in: [groups]))
+        XCTAssertFalse(self.isQuiet(contact, in: [groups], isContact: true))
+
+        let channels = self.folder(.channels)
+        XCTAssertTrue(self.isQuiet(channel, in: [channels]))
+        XCTAssertFalse(self.isQuiet(group, in: [channels]))
+
+        let contacts = self.folder(.contacts)
+        XCTAssertTrue(self.isQuiet(contact, in: [contacts], isContact: true))
+        XCTAssertFalse(self.isQuiet(stranger, in: [contacts]))
+
+        let nonContacts = self.folder(.nonContacts)
+        XCTAssertTrue(self.isQuiet(stranger, in: [nonContacts]))
+        XCTAssertFalse(self.isQuiet(contact, in: [nonContacts], isContact: true))
+
+        let bots = self.folder(.bots)
+        XCTAssertTrue(self.isQuiet(bot, in: [bots]))
+        XCTAssertFalse(self.isQuiet(stranger, in: [bots]))
+        XCTAssertFalse(self.isQuiet(bot, in: [nonContacts]))
+    }
+
+    func testIncludedExcludedAndPinnedChats() {
+        let anna = self.user(10)
+        let group = self.group(20)
+        let otherGroup = self.group(21)
+        let channel = self.channel(30)
+        // A folder of a list of chats, like "Work".
+        let work = self.folder([], include: [anna, group])
+        XCTAssertTrue(self.isQuiet(anna, in: [work]))
+        XCTAssertTrue(self.isQuiet(group, in: [work]))
+        XCTAssertFalse(self.isQuiet(otherGroup, in: [work]))
+
+        // An excluded chat stays out even when its type is in the folder.
+        let groupsButOne = self.folder(.groups, exclude: [otherGroup])
+        XCTAssertTrue(self.isQuiet(group, in: [groupsButOne]))
+        XCTAssertFalse(self.isQuiet(otherGroup, in: [groupsButOne]))
+
+        // A pinned chat is in the folder whatever its type, archived or not, even before it is in any chat list.
+        let groupsAndPinnedChannel = self.folder(.groups, pinned: [channel])
+        XCTAssertTrue(self.isQuiet(channel, in: [groupsAndPinnedChannel]))
+        XCTAssertTrue(self.isQuiet(channel, in: [groupsAndPinnedChannel], groupId: .archive))
+        XCTAssertTrue(self.isQuiet(channel, in: [groupsAndPinnedChannel], groupId: nil))
+        XCTAssertFalse(self.isQuiet(group, in: [groupsAndPinnedChannel], groupId: nil))
+    }
+
+    func testArchivedChats() {
+        let group = self.group(20)
+        XCTAssertTrue(self.isQuiet(group, in: [self.folder(.groups)], groupId: .archive))
+        XCTAssertFalse(self.isQuiet(group, in: [self.folder(.groups, excludeArchived: true)], groupId: .archive))
+        XCTAssertTrue(self.isQuiet(group, in: [self.folder(.groups, excludeArchived: true)], groupId: .root))
+    }
+
+    // A folder that hides muted or read chats still keeps its quiet hours for them: being muted or read is not a rule
+    // of which chats are in it, and quiet hours must not end for a chat once it has been read.
+    func testMutedAndReadChatsStayIn() {
+        let group = self.group(20)
+        let unreadUnmutedGroups = self.folder(.groups, excludeMuted: true, excludeRead: true)
+        XCTAssertTrue(self.isQuiet(group, in: [unreadUnmutedGroups]))
+    }
+
+    // A secret chat is a contact's chat when its user is a contact, as in the folder's own chat list.
+    func testSecretChatsFollowTheirUser() {
+        let secret = self.secretChat(40, with: self.user(10))
+        XCTAssertTrue(self.isQuiet(secret, in: [self.folder(.contacts)], isContact: true))
+        XCTAssertFalse(self.isQuiet(secret, in: [self.folder(.nonContacts)], isContact: true))
+        XCTAssertTrue(self.isQuiet(secret, in: [self.folder(.nonContacts)], isContact: false))
+    }
+
+    // A chat in several folders is quiet while any of them is.
+    func testAnyOfSeveralFolders() {
+        let mike = self.user(10)
+        let work = self.folder([], id: 2, include: [mike])
+        let personal = self.folder(.groups, id: 3)
+        XCTAssertTrue(self.isQuiet(mike, in: [personal, work]))
+        XCTAssertFalse(self.isQuiet(mike, in: [personal]))
+        XCTAssertFalse(self.isQuiet(mike, in: []))
+    }
+}
