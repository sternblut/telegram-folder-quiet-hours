+import Foundation
+import XCTest
+import FolderNotificationSchedule
+
+final class FolderNotificationScheduleTests: XCTestCase {
+    private func calendar(_ timeZoneId: String) -> Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: timeZoneId)!
+        return calendar
+    }
+
+    // A wall-clock moment in `calendar`'s time zone.
+    private func date(_ calendar: Calendar, _ year: Int, _ month: Int, _ day: Int, _ hour: Int, _ minute: Int) -> Date {
+        var components = DateComponents()
+        components.year = year
+        components.month = month
+        components.day = day
+        components.hour = hour
+        components.minute = minute
+        return calendar.date(from: components)!
+    }
+
+    private func minutes(_ hour: Int32, _ minute: Int32) -> Int32 {
+        return hour * 60 + minute
+    }
+
+    // 2026-10-26 is a Monday.
+    private let mondayDay = 26
+
+    func testSameDayWindow() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .weekdays, startMinute: self.minutes(9, 0), endMinute: self.minutes(18, 0))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 8, 59), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 9, 0), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 17, 59), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 18, 0), calendar: calendar))
+        // Saturday is not in the set.
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 5, 10, 0), calendar: calendar))
+    }
+
+    func testNightWindowEveryDay() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .everyDay, startMinute: self.minutes(22, 0), endMinute: self.minutes(7, 0))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 21, 59), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 22, 0), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 2, 0), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 6, 59), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 7, 0), calendar: calendar))
+    }
+
+    // A night window belongs to the day it starts on.
+    func testNightWindowBelongsToItsStartDay() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .weekdays, startMinute: self.minutes(22, 0), endMinute: self.minutes(7, 0))
+        // Friday night runs into Saturday morning.
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 5, 6, 0), calendar: calendar))
+        // Saturday and Sunday nights are not in the set.
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 5, 23, 0), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 6, 6, 0), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 11, 2, 6, 0), calendar: calendar))
+        // Monday night runs into Tuesday morning.
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 6, 0), calendar: calendar))
+    }
+
+    func testWholeDay() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .weekends, startMinute: 0, endMinute: 0)
+        XCTAssertTrue(schedule.isWholeDay)
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 4, 23, 59), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 5, 0, 0), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 6, 23, 59), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 11, 2, 0, 0), calendar: calendar))
+    }
+
+    // Equal start and end that is not midnight is a 24-hour window.
+    func testTwentyFourHoursFromStart() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: [.monday], startMinute: self.minutes(9, 0), endMinute: self.minutes(9, 0))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 8, 59), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay, 9, 0), calendar: calendar))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 8, 59), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 10, self.mondayDay + 1, 9, 0), calendar: calendar))
+    }
+
+    // Sunday night continues into Monday morning across the end of the week.
+    func testWeekWrap() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: [.sunday], startMinute: self.minutes(23, 0), endMinute: self.minutes(1, 0))
+        XCTAssertTrue(schedule.contains(self.date(calendar, 2026, 11, 2, 0, 30), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 11, 2, 1, 0), calendar: calendar))
+        XCTAssertFalse(schedule.contains(self.date(calendar, 2026, 11, 3, 0, 30), calendar: calendar))
+    }
+
+    func testEmptyAndFullSchedulesNeverChange() {
+        let calendar = self.calendar("Europe/Berlin")
+        let now = self.date(calendar, 2026, 10, self.mondayDay, 12, 0)
+        let empty = FolderNotificationSchedule(days: [], startMinute: self.minutes(9, 0), endMinute: self.minutes(18, 0))
+        XCTAssertFalse(empty.contains(now, calendar: calendar))
+        XCTAssertNil(empty.nextTransition(after: now, calendar: calendar))
+
+        let full = FolderNotificationSchedule(days: .everyDay, startMinute: self.minutes(6, 0), endMinute: self.minutes(6, 0))
+        XCTAssertTrue(full.contains(now, calendar: calendar))
+        XCTAssertNil(full.nextTransition(after: now, calendar: calendar))
+    }
+
+    func testNextTransition() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .weekdays, startMinute: self.minutes(9, 0), endMinute: self.minutes(18, 0))
+        XCTAssertEqual(schedule.nextTransition(after: self.date(calendar, 2026, 10, self.mondayDay, 8, 0), calendar: calendar), self.date(calendar, 2026, 10, self.mondayDay, 9, 0))
+        XCTAssertEqual(schedule.nextTransition(after: self.date(calendar, 2026, 10, self.mondayDay, 9, 0), calendar: calendar), self.date(calendar, 2026, 10, self.mondayDay, 18, 0))
+        XCTAssertEqual(schedule.nextTransition(after: self.date(calendar, 2026, 10, self.mondayDay, 10, 0), calendar: calendar), self.date(calendar, 2026, 10, self.mondayDay, 18, 0))
+        // Friday evening: the next change is Monday morning.
+        XCTAssertEqual(schedule.nextTransition(after: self.date(calendar, 2026, 10, self.mondayDay + 4, 18, 30), calendar: calendar), self.date(calendar, 2026, 11, 2, 9, 0))
+    }
+
+    // Every night plus whole weekends: one quiet stretch from Friday evening to Monday morning.
+    func testUnionOfNightAndWeekendWindows() {
+        let calendar = self.calendar("Europe/Berlin")
+        let entry = FolderNotificationScheduleEntry(isEnabled: true, schedules: [
+            FolderNotificationSchedule(days: .everyDay, startMinute: self.minutes(19, 0), endMinute: self.minutes(9, 0)),
+            FolderNotificationSchedule(days: .weekends, startMinute: 0, endMinute: 0)
+        ])
+        let mondayMorning = self.date(calendar, 2026, 11, 2, 9, 0)
+        for (day, hour) in [(30, 20), (31, 12), (1, 7)] {
+            let month = day == 1 ? 11 : 10
+            let now = self.date(calendar, 2026, month, day, hour, 0)
+            XCTAssertTrue(entry.isActive(at: now, calendar: calendar))
+            XCTAssertEqual(entry.nextTransition(after: now, calendar: calendar), mondayMorning)
+        }
+        XCTAssertFalse(entry.isActive(at: mondayMorning, calendar: calendar))
+        XCTAssertEqual(entry.nextTransition(after: mondayMorning, calendar: calendar), self.date(calendar, 2026, 11, 2, 19, 0))
+    }
+
+    // Europe/Berlin goes from 02:00 to 03:00 on 2026-03-29. A window that starts at 02:30 starts at 03:00 that night.
+    func testClocksGoForwardOverTheStart() {
+        let calendar = self.calendar("Europe/Berlin")
+        let schedule = FolderNotificationSchedule(days: .everyDay, startMinute: self.minutes(2, 30), endMinute: self.minutes(4, 0))
+        let before = self.date(calendar, 2026, 3, 29, 1, 59)
+        XCTAssertFalse(schedule.contains(before, calendar: calendar))
+        let transition = schedule.nextTransition(after: before, calendar: calendar)
+        XCTAssertEqual(transition, before.addingTimeInterval(60))
+        if let transition {
+            XCTAssertTrue(schedule.contains(transition, calendar: calendar))
+            XCTAssertEqual(calendar.component(.hour, from: transition), 3)
+        }
+    }
+
+    // Europe/Berlin goes back from 03:00 to 02:00 on 2026-10-25, so 02:00–03:00 happens twice. A window of
+    // 02:30–04:00 is left at the clock change and entered again at the second 02:30.
+    func testClocksGoBackInsideTheWindow() {
+        let calendar = self.calendar("Europe/Berlin")
+        let utc = self.calendar("UTC")
+        let schedule = FolderNotificationSchedule(days: .everyDay, startMinute: self.minutes(2, 30), endMinute: self.minutes(4, 0))
+        let summerQuarterToThree = self.date(utc, 2026, 10, 25, 0, 45)
+        XCTAssertTrue(schedule.contains(summerQuarterToThree, calendar: calendar))
+        let clockChange = self.date(utc, 2026, 10, 25, 1, 0)
+        XCTAssertEqual(schedule.nextTransition(after: summerQuarterToThree, calendar: calendar), clockChange)
+        XCTAssertEqual(schedule.nextTransition(after: clockChange, calendar: calendar), self.date(utc, 2026, 10, 25, 1, 30))
+    }
+
+    // Windows that begin or end right where the clocks change, in zones that change at midnight
+    // (Santiago), at 23:00 local time (Scoresbysund) or by half an hour (Lord Howe).
+    func testWindowsAtClockChangesMatchMinuteWalk() {
+        let utc = self.calendar("UTC")
+        for timeZoneId in ["Europe/Berlin", "America/New_York", "America/Santiago", "America/Scoresbysund", "Australia/Lord_Howe"] {
+            let calendar = self.calendar(timeZoneId)
+            var changes: [Date] = []
+            var cursor = self.date(utc, 2026, 1, 1, 0, 0)
+            while let next = calendar.timeZone.nextDaylightSavingTimeTransition(after: cursor), next < self.date(utc, 2027, 1, 1, 0, 0) {
+                changes.append(next)
+                cursor = next
+            }
+            XCTAssertEqual(changes.count, 2, timeZoneId)
+            for change in changes {
+                // The wall-clock minute the old offset reaches at the change, and the one the new offset starts from.
+                let before = FolderNotificationSchedule.position(of: change.addingTimeInterval(-60.0), calendar: calendar).minute + 1
+                let after = FolderNotificationSchedule.position(of: change, calendar: calendar)
+                let boundaries = Set([before, after.minute, before - 30, before + 30, after.minute - 30, after.minute + 30].map { ($0 + 1440) % 1440 })
+                let daySets: [FolderNotificationSchedule.Days] = [.everyDay, FolderNotificationSchedule.Days(dayIndex: after.dayIndex), FolderNotificationSchedule.Days(dayIndex: (after.dayIndex + 6) % 7)]
+                for days in daySets {
+                    for start in boundaries {
+                        for end in boundaries where end != start {
+                            let schedule = FolderNotificationSchedule(days: days, startMinute: start, endMinute: end)
+                            for now in [change.addingTimeInterval(-3.0 * 60.0 * 60.0), change.addingTimeInterval(-60.0)] {
+                                XCTAssertEqual(schedule.nextTransition(after: now, calendar: calendar), self.walkToNextTransition(schedule: schedule, after: now, calendar: calendar), "\(timeZoneId) \(schedule) \(now)")
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // The fast transition search must agree with a minute-by-minute walk, including across clock changes.
+    func testNextTransitionMatchesMinuteWalk() {
+        var generator = SeededGenerator(seed: 0x5eed)
+        let timeZones = ["Europe/Berlin", "America/New_York", "Australia/Sydney", "Pacific/Chatham", "Asia/Kolkata", "UTC"]
+        // Around the 2026 clock changes of those zones, plus ordinary days.
+        let origins: [(Int, Int, Int)] = [(2026, 3, 7), (2026, 3, 28), (2026, 4, 4), (2026, 9, 26), (2026, 10, 3), (2026, 10, 24), (2026, 10, 31), (2026, 6, 15)]
+        for timeZoneId in timeZones {
+            let calendar = self.calendar(timeZoneId)
+            for origin in origins {
+                for _ in 0 ..< 12 {
+                    let days = FolderNotificationSchedule.Days(rawValue: Int32(generator.next() % 128))
+                    let start = Int32(generator.next() % 1440)
+                    let end = generator.next() % 4 == 0 ? start : Int32(generator.next() % 1440)
+                    let schedule = FolderNotificationSchedule(days: days, startMinute: start, endMinute: end)
+                    let offsetMinutes = Int(generator.next() % UInt64(3 * 1440))
+                    let base = self.date(calendar, origin.0, origin.1, origin.2, 0, 0)
+                    let now = calendar.date(byAdding: .minute, value: offsetMinutes, to: base)!.addingTimeInterval(Double(generator.next() % 60))
+                    XCTAssertEqual(schedule.nextTransition(after: now, calendar: calendar), self.walkToNextTransition(schedule: schedule, after: now, calendar: calendar), "\(timeZoneId) \(schedule) \(now)")
+                }
+            }
+        }
+    }
+
+    private func walkToNextTransition(schedule: FolderNotificationSchedule, after date: Date, calendar: Calendar) -> Date? {
+        let current = schedule.contains(date, calendar: calendar)
+        var candidate = calendar.dateInterval(of: .minute, for: date)!.start
+        for _ in 0 ..< 9 * 1440 {
+            candidate = candidate.addingTimeInterval(60)
+            if schedule.contains(candidate, calendar: calendar) != current {
+                return candidate
+            }
+        }
+        return nil
+    }
+
+    // Every day set and window kind against a minute-by-minute reference.
+    func testSchedulesMinuteByMinute() {
+        let minutesPerDay = Int(FolderNotificationSchedule.minutesPerDay)
+        let minutesPerWeek = 7 * minutesPerDay
+        let edges: [Int32] = [0, 1, 59, 720, 1140, 1380, 1438, 1439]
+        let windows: [(Int32, Int32)] = [(540, 1080), (1140, 540), (0, 0), (720, 720), (1080, 0), (0, 1), (1439, 0), (1, 0)]
+        let daySets: [Int32] = [0, 1 << 0, 1 << 6, 0b0011111, 0b1100000, 0b1111111, 0b1000001, 0b1010101]
+        var schedules: [FolderNotificationSchedule] = []
+        for days in Int32(0) ..< 128 {
+            for (start, end) in windows {
+                schedules.append(FolderNotificationSchedule(days: FolderNotificationSchedule.Days(rawValue: days), startMinute: start, endMinute: end))
+            }
+        }
+        for days in daySets {
+            for start in edges {
+                for end in edges {
+                    schedules.append(FolderNotificationSchedule(days: FolderNotificationSchedule.Days(rawValue: days), startMinute: start, endMinute: end))
+                }
+            }
+        }
+        for schedule in schedules {
+            let start = Int(schedule.startMinute)
+            let end = Int(schedule.endMinute)
+            let length = end > start ? end - start : minutesPerDay - start + end
+            var expected = [Bool](repeating: false, count: minutesPerWeek)
+            for dayIndex in 0 ..< 7 where schedule.days.rawValue & (1 << dayIndex) != 0 {
+                for offset in 0 ..< length {
+                    expected[(dayIndex * minutesPerDay + start + offset) % minutesPerWeek] = true
+                }
+            }
+            for minuteOfWeek in 0 ..< minutesPerWeek {
+                if schedule.contains(dayIndex: minuteOfWeek / minutesPerDay, minute: Int32(minuteOfWeek % minutesPerDay)) != expected[minuteOfWeek] {
+                    XCTFail("\(schedule) on day \(minuteOfWeek / minutesPerDay) at minute \(minuteOfWeek % minutesPerDay)")
+                    return
+                }
+            }
+        }
+    }
+
+    func testDayIndicesFollowTheWeekWhateverTheFirstWeekday() {
+        var calendar = self.calendar("Europe/Berlin")
+        calendar.firstWeekday = 1
+        let sunday = self.date(calendar, 2026, 11, 1, 12, 0)
+        XCTAssertEqual(FolderNotificationSchedule.position(of: sunday, calendar: calendar).dayIndex, 6)
+        calendar.firstWeekday = 2
+        XCTAssertEqual(FolderNotificationSchedule.position(of: sunday, calendar: calendar).dayIndex, 6)
+        XCTAssertEqual(FolderNotificationSchedule.position(of: self.date(calendar, 2026, 10, self.mondayDay, 0, 0), calendar: calendar).dayIndex, 0)
+    }
+
+    func testCodingRoundTripAndSanitizing() throws {
+        let entry = FolderNotificationScheduleEntry(isEnabled: true, schedules: [
+            FolderNotificationSchedule(days: [.monday, .friday], startMinute: self.minutes(19, 30), endMinute: self.minutes(8, 15)),
+            FolderNotificationSchedule(days: .weekends, startMinute: 0, endMinute: 0)
+        ])
+        let data = try JSONEncoder().encode(entry)
+        XCTAssertEqual(try JSONDecoder().decode(FolderNotificationScheduleEntry.self, from: data), entry)
+
+        // Out-of-range values from a damaged store are clamped and unknown day bits dropped.
+        let damaged = "{\"sc\":[{\"d\":1023,\"s\":5000,\"e\":-3}],\"en\":false}".data(using: .utf8)!
+        let decoded = try JSONDecoder().decode(FolderNotificationScheduleEntry.self, from: damaged)
+        XCTAssertEqual(decoded.schedules.count, 1)
+        XCTAssertEqual(decoded.schedules.first?.days, .everyDay)
+        XCTAssertEqual(decoded.schedules.first?.startMinute, 1439)
+        XCTAssertEqual(decoded.schedules.first?.endMinute, 0)
+        XCTAssertFalse(decoded.isEnabled)
+    }
+}
+
+// Deterministic generator so a failure reproduces.
+private struct SeededGenerator {
+    private var state: UInt64
+
+    init(seed: UInt64) {
+        self.state = seed
+    }
+
+    mutating func next() -> UInt64 {
+        self.state = self.state &* 6364136223846793005 &+ 1442695040888963407
+        return self.state >> 17
+    }
+}
