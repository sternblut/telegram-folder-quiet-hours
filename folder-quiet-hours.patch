@@ -0,0 +1,100 @@
+import Foundation
+import TelegramPresentationData
+import TelegramStringFormatting
+import TextFormat
+import FolderNotificationSchedule
+
+func folderNotificationScheduleShortDayNames(strings: PresentationStrings) -> [String] {
+    return [
+        strings.Weekday_ShortMonday,
+        strings.Weekday_ShortTuesday,
+        strings.Weekday_ShortWednesday,
+        strings.Weekday_ShortThursday,
+        strings.Weekday_ShortFriday,
+        strings.Weekday_ShortSaturday,
+        strings.Weekday_ShortSunday
+    ]
+}
+
+func folderNotificationScheduleFullDayNames(strings: PresentationStrings) -> [String] {
+    return [
+        strings.Weekday_Monday,
+        strings.Weekday_Tuesday,
+        strings.Weekday_Wednesday,
+        strings.Weekday_Thursday,
+        strings.Weekday_Friday,
+        strings.Weekday_Saturday,
+        strings.Weekday_Sunday
+    ]
+}
+
+func folderNotificationScheduleTimeText(minute: Int32, dateTimeFormat: PresentationDateTimeFormat) -> String {
+    return stringForShortTimestamp(hours: minute / 60, minutes: minute % 60, dateTimeFormat: dateTimeFormat)
+}
+
+func folderNotificationScheduleDaysText(_ days: FolderNotificationSchedule.Days, strings: PresentationStrings) -> String {
+    if days == .everyDay {
+        return strings.FolderQuietHours_EveryDay
+    }
+    if days == .weekdays {
+        return strings.FolderQuietHours_Weekdays
+    }
+    if days == .weekends {
+        return strings.FolderQuietHours_Weekends
+    }
+    let names = folderNotificationScheduleShortDayNames(strings: strings)
+    guard let first = (0 ..< 7).first(where: { days.contains(dayIndex: $0) && !days.contains(dayIndex: ($0 + 6) % 7) }) else {
+        return ""
+    }
+    let indices = (0 ..< 7).map { (first + $0) % 7 }.filter { days.contains(dayIndex: $0) }
+    var parts: [String] = []
+    var index = 0
+    while index < indices.count {
+        var end = index
+        while end + 1 < indices.count && indices[end + 1] == (indices[end] + 1) % 7 {
+            end += 1
+        }
+        if end - index >= 2 {
+            parts.append("\(names[indices[index]])–\(names[indices[end]])")
+        } else {
+            for i in index ... end {
+                parts.append(names[indices[i]])
+            }
+        }
+        index = end + 1
+    }
+    return parts.joined(separator: ", ")
+}
+
+func folderNotificationScheduleWindowText(_ schedule: FolderNotificationSchedule, strings: PresentationStrings, dateTimeFormat: PresentationDateTimeFormat) -> String {
+    let days = folderNotificationScheduleDaysText(schedule.days, strings: strings)
+    if schedule.isWholeDay && schedule.startMinute == 0 {
+        return "\(days), \(strings.FolderQuietHours_AllDay)"
+    }
+    let start = folderNotificationScheduleTimeText(minute: schedule.startMinute, dateTimeFormat: dateTimeFormat)
+    let end = folderNotificationScheduleTimeText(minute: schedule.endMinute, dateTimeFormat: dateTimeFormat)
+    return "\(days), \(start)\u{00a0}– \(end)"
+}
+
+public func folderNotificationScheduleSummary(_ entry: FolderNotificationScheduleEntry?, strings: PresentationStrings, dateTimeFormat: PresentationDateTimeFormat) -> String? {
+    guard let entry, entry.isEnabled, !entry.schedules.isEmpty else {
+        return nil
+    }
+    return entry.schedules.map { folderNotificationScheduleWindowText($0, strings: strings, dateTimeFormat: dateTimeFormat) }.joined(separator: "; ")
+}
+
+public func folderNotificationScheduleStatus(_ entry: FolderNotificationScheduleEntry?, at date: Date, calendar: Calendar, strings: PresentationStrings, dateTimeFormat: PresentationDateTimeFormat) -> String? {
+    guard let entry, entry.isEnabled, !entry.schedules.isEmpty else {
+        return nil
+    }
+    guard let change = entry.nextTransition(after: date, calendar: calendar) else {
+        return entry.isActive(at: date, calendar: calendar) ? strings.FolderQuietHours_StatusAlways : nil
+    }
+    let position = FolderNotificationSchedule.position(of: change, calendar: calendar)
+    var time = folderNotificationScheduleTimeText(minute: position.minute, dateTimeFormat: dateTimeFormat)
+    if change.timeIntervalSince(date) >= 24.0 * 60.0 * 60.0 {
+        time = "\(folderNotificationScheduleShortDayNames(strings: strings)[position.dayIndex]) \(time)"
+    }
+    let template = entry.isActive(at: date, calendar: calendar) ? strings.FolderQuietHours_StatusUntil : strings.FolderQuietHours_StatusFrom
+    return template.replacingOccurrences(of: "{time}", with: time)
+}
