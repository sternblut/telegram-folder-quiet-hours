+import Foundation
+import UIKit
+import Display
+import ComponentFlow
+import TelegramPresentationData
+import ListSectionComponent
+import FolderNotificationSchedule
+
+final class FolderNotificationScheduleDaysComponent: Component {
+    let theme: PresentationTheme
+    let shortNames: [String]
+    let fullNames: [String]
+    let days: FolderNotificationSchedule.Days
+    let toggle: (Int) -> Void
+    
+    init(theme: PresentationTheme, shortNames: [String], fullNames: [String], days: FolderNotificationSchedule.Days, toggle: @escaping (Int) -> Void) {
+        self.theme = theme
+        self.shortNames = shortNames
+        self.fullNames = fullNames
+        self.days = days
+        self.toggle = toggle
+    }
+    
+    static func ==(lhs: FolderNotificationScheduleDaysComponent, rhs: FolderNotificationScheduleDaysComponent) -> Bool {
+        if lhs.theme !== rhs.theme {
+            return false
+        }
+        if lhs.shortNames != rhs.shortNames || lhs.fullNames != rhs.fullNames {
+            return false
+        }
+        if lhs.days != rhs.days {
+            return false
+        }
+        return true
+    }
+    
+    private final class DayButton: HighlightTrackingButton {
+        let background = UIView()
+        let label = ImmediateTextView()
+        
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.background.isUserInteractionEnabled = false
+            self.addSubview(self.background)
+            self.label.isUserInteractionEnabled = false
+            self.addSubview(self.label)
+            self.isAccessibilityElement = true
+            self.highligthedChanged = { [weak self] highlighted in
+                guard let self else {
+                    return
+                }
+                if highlighted {
+                    self.background.layer.removeAnimation(forKey: "transform.scale")
+                    self.background.layer.transform = CATransform3DMakeScale(0.9, 0.9, 1.0)
+                } else {
+                    let transition = ComponentTransition(animation: .curve(duration: 0.25, curve: .spring))
+                    transition.setScale(view: self.background, scale: 1.0)
+                }
+            }
+        }
+        
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+    }
+    
+    final class View: UIView, ListSectionComponent.ChildView {
+        private var buttons: [DayButton] = []
+        private var component: FolderNotificationScheduleDaysComponent?
+        
+        var customUpdateIsHighlighted: ((Bool) -> Void)?
+        var enumerateSiblings: (((UIView) -> Void) -> Void)?
+        private(set) var separatorInset: CGFloat = 16.0
+        
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            for index in 0 ..< 7 {
+                let button = DayButton()
+                button.tag = index
+                button.addTarget(self, action: #selector(self.buttonPressed(_:)), for: .touchUpInside)
+                self.buttons.append(button)
+                self.addSubview(button)
+            }
+        }
+        
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+        
+        @objc private func buttonPressed(_ button: UIButton) {
+            self.component?.toggle(button.tag)
+        }
+        
+        func update(component: FolderNotificationScheduleDaysComponent, availableSize: CGSize, transition: ComponentTransition) -> CGSize {
+            self.component = component
+            
+            let sideInset: CGFloat = 16.0
+            let verticalInset: CGFloat = 12.0
+            let contentWidth = availableSize.width - sideInset * 2.0
+            let count: CGFloat = 7.0
+            let diameter: CGFloat = min(40.0, floor((contentWidth - 6.0 * 4.0) / count))
+            let spacing: CGFloat = floor((contentWidth - diameter * count) / (count - 1.0))
+            let totalWidth = diameter * count + spacing * (count - 1.0)
+            let originX = floor((availableSize.width - totalWidth) / 2.0)
+            
+            for (index, button) in self.buttons.enumerated() {
+                let isSelected = component.days.contains(dayIndex: index)
+                let frame = CGRect(origin: CGPoint(x: originX + CGFloat(index) * (diameter + spacing), y: verticalInset), size: CGSize(width: diameter, height: diameter))
+                transition.setFrame(view: button, frame: frame)
+                button.background.frame = CGRect(origin: CGPoint(), size: frame.size)
+                button.background.layer.cornerRadius = diameter / 2.0
+                
+                let fillColor = isSelected ? component.theme.list.itemCheckColors.fillColor : component.theme.list.itemPrimaryTextColor.withMultipliedAlpha(0.08)
+                let textColor = isSelected ? component.theme.list.itemCheckColors.foregroundColor : component.theme.list.itemPrimaryTextColor
+                transition.setBackgroundColor(view: button.background, color: fillColor)
+                
+                button.label.attributedText = NSAttributedString(string: component.shortNames[index], font: Font.semibold(13.0), textColor: textColor)
+                let labelSize = button.label.updateLayout(CGSize(width: diameter, height: diameter))
+                button.label.frame = CGRect(origin: CGPoint(x: floor((diameter - labelSize.width) / 2.0), y: floor((diameter - labelSize.height) / 2.0)), size: labelSize)
+                
+                button.accessibilityLabel = component.fullNames[index]
+                button.accessibilityTraits = isSelected ? [.button, .selected] : [.button]
+            }
+            
+            return CGSize(width: availableSize.width, height: diameter + verticalInset * 2.0)
+        }
+    }
+    
+    func makeView() -> View {
+        return View(frame: CGRect())
+    }
+    
+    func update(view: View, availableSize: CGSize, state: EmptyComponentState, environment: Environment<Empty>, transition: ComponentTransition) -> CGSize {
+        return view.update(component: self, availableSize: availableSize, transition: transition)
+    }
+}
