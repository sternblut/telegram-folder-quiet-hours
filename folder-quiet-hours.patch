@@ -0,0 +1,186 @@
+import Foundation
+
+// endMinute <= startMinute ends the next day; equal start and end is 24 hours.
+public struct FolderNotificationSchedule: Codable, Equatable {
+    public struct Days: OptionSet, Hashable {
+        public var rawValue: Int32
+        
+        public init(rawValue: Int32) {
+            self.rawValue = rawValue
+        }
+        
+        public static let monday = Days(rawValue: 1 << 0)
+        public static let tuesday = Days(rawValue: 1 << 1)
+        public static let wednesday = Days(rawValue: 1 << 2)
+        public static let thursday = Days(rawValue: 1 << 3)
+        public static let friday = Days(rawValue: 1 << 4)
+        public static let saturday = Days(rawValue: 1 << 5)
+        public static let sunday = Days(rawValue: 1 << 6)
+        
+        public static let weekdays: Days = [.monday, .tuesday, .wednesday, .thursday, .friday]
+        public static let weekends: Days = [.saturday, .sunday]
+        public static let everyDay: Days = [.weekdays, .weekends]
+        
+        public init(dayIndex: Int) {
+            self.init(rawValue: 1 << Int32(dayIndex))
+        }
+        
+        public func contains(dayIndex: Int) -> Bool {
+            return self.contains(Days(dayIndex: dayIndex))
+        }
+    }
+    
+    public static let minutesPerDay: Int32 = 24 * 60
+    
+    public var days: Days
+    public var startMinute: Int32
+    public var endMinute: Int32
+    
+    public init(days: Days, startMinute: Int32, endMinute: Int32) {
+        self.days = days
+        self.startMinute = FolderNotificationSchedule.clampMinute(startMinute)
+        self.endMinute = FolderNotificationSchedule.clampMinute(endMinute)
+    }
+    
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.days = Days(rawValue: try container.decode(Int32.self, forKey: .days) & Days.everyDay.rawValue)
+        self.startMinute = FolderNotificationSchedule.clampMinute(try container.decode(Int32.self, forKey: .startMinute))
+        self.endMinute = FolderNotificationSchedule.clampMinute(try container.decode(Int32.self, forKey: .endMinute))
+    }
+    
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(self.days.rawValue, forKey: .days)
+        try container.encode(self.startMinute, forKey: .startMinute)
+        try container.encode(self.endMinute, forKey: .endMinute)
+    }
+    
+    private enum CodingKeys: String, CodingKey {
+        case days = "d"
+        case startMinute = "s"
+        case endMinute = "e"
+    }
+    
+    private static func clampMinute(_ value: Int32) -> Int32 {
+        return max(0, min(FolderNotificationSchedule.minutesPerDay - 1, value))
+    }
+    
+    public var isWholeDay: Bool {
+        return self.startMinute == self.endMinute
+    }
+    
+    public var endsNextDay: Bool {
+        return self.endMinute <= self.startMinute
+    }
+    
+    public static func position(of date: Date, calendar: Calendar) -> (dayIndex: Int, minute: Int32) {
+        let components = calendar.dateComponents([.weekday, .hour, .minute], from: date)
+        let weekday = components.weekday ?? 2
+        let dayIndex = (weekday + 5) % 7
+        let minute = Int32((components.hour ?? 0) * 60 + (components.minute ?? 0))
+        return (dayIndex, minute)
+    }
+    
+    public func contains(_ date: Date, calendar: Calendar) -> Bool {
+        let (dayIndex, minute) = FolderNotificationSchedule.position(of: date, calendar: calendar)
+        return self.contains(dayIndex: dayIndex, minute: minute)
+    }
+    
+    public func contains(dayIndex: Int, minute: Int32) -> Bool {
+        if self.days.contains(dayIndex: dayIndex) {
+            if self.endMinute > self.startMinute {
+                if minute >= self.startMinute && minute < self.endMinute {
+                    return true
+                }
+            } else if minute >= self.startMinute {
+                return true
+            }
+        }
+        let previousDayIndex = (dayIndex + 6) % 7
+        if self.days.contains(dayIndex: previousDayIndex) && self.endsNextDay && minute < self.endMinute {
+            return true
+        }
+        return false
+    }
+    
+    // Only boundary minutes and clock changes in the next eight days can change the answer.
+    public func nextTransition(after date: Date, calendar: Calendar) -> Date? {
+        return FolderNotificationSchedule.nextTransition(of: [self], after: date, calendar: calendar)
+    }
+    
+    public static func nextTransition(of schedules: [FolderNotificationSchedule], after date: Date, calendar: Calendar) -> Date? {
+        let schedules = schedules.filter { !$0.days.isEmpty }
+        if schedules.isEmpty {
+            return nil
+        }
+        if schedules.contains(where: { $0.days == .everyDay && $0.isWholeDay }) {
+            return nil
+        }
+        let isInside: (Date) -> Bool = { date in
+            return schedules.contains(where: { $0.contains(date, calendar: calendar) })
+        }
+        let current = isInside(date)
+        var boundaryMinutes = Set<Int32>()
+        for schedule in schedules {
+            boundaryMinutes.insert(schedule.startMinute)
+            boundaryMinutes.insert(schedule.endMinute)
+        }
+        let startOfDay = calendar.startOfDay(for: date)
+        var candidates: [Date] = []
+        for dayOffset in 0 ... 8 {
+            guard let day = calendar.date(byAdding: .day, value: dayOffset, to: startOfDay) else {
+                continue
+            }
+            for minute in boundaryMinutes {
+                for repeatedTimePolicy in [Calendar.RepeatedTimePolicy.first, .last] {
+                    if let candidate = calendar.date(bySettingHour: Int(minute / 60), minute: Int(minute % 60), second: 0, of: day, matchingPolicy: .nextTime, repeatedTimePolicy: repeatedTimePolicy, direction: .forward), candidate > date {
+                        candidates.append(candidate)
+                    }
+                }
+            }
+        }
+        let searchEnd = date.addingTimeInterval(9.0 * 24.0 * 60.0 * 60.0)
+        var clockChange = date
+        while let next = calendar.timeZone.nextDaylightSavingTimeTransition(after: clockChange), next < searchEnd {
+            candidates.append(next)
+            clockChange = next
+        }
+        candidates.sort()
+        for candidate in candidates {
+            if isInside(candidate) != current {
+                return candidate
+            }
+        }
+        return nil
+    }
+}
+
+public struct FolderNotificationScheduleEntry: Codable, Equatable {
+    public var isEnabled: Bool
+    public var schedules: [FolderNotificationSchedule]
+    
+    public init(isEnabled: Bool, schedules: [FolderNotificationSchedule]) {
+        self.isEnabled = isEnabled
+        self.schedules = schedules
+    }
+    
+    private enum CodingKeys: String, CodingKey {
+        case isEnabled = "en"
+        case schedules = "sc"
+    }
+    
+    public func isActive(at date: Date, calendar: Calendar) -> Bool {
+        if !self.isEnabled {
+            return false
+        }
+        return self.schedules.contains(where: { $0.contains(date, calendar: calendar) })
+    }
+    
+    public func nextTransition(after date: Date, calendar: Calendar) -> Date? {
+        if !self.isEnabled {
+            return nil
+        }
+        return FolderNotificationSchedule.nextTransition(of: self.schedules, after: date, calendar: calendar)
+    }
+}
