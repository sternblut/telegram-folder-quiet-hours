+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import FolderNotificationSchedule
+
+public struct ChatListFolderNotificationScheduleSettings: Equatable, Codable {
+    public struct Folder: Equatable, Codable {
+        public var id: Int32
+        public var entry: FolderNotificationScheduleEntry
+        
+        public init(id: Int32, entry: FolderNotificationScheduleEntry) {
+            self.id = id
+            self.entry = entry
+        }
+        
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: StringCodingKey.self)
+            
+            self.id = try container.decode(Int32.self, forKey: "id")
+            self.entry = try container.decode(FolderNotificationScheduleEntry.self, forKey: "entry")
+        }
+        
+        public func encode(to encoder: Encoder) throws {
+            var container = encoder.container(keyedBy: StringCodingKey.self)
+            
+            try container.encode(self.id, forKey: "id")
+            try container.encode(self.entry, forKey: "entry")
+        }
+    }
+    
+    public var folders: [Folder]
+    
+    public static var `default`: ChatListFolderNotificationScheduleSettings {
+        return ChatListFolderNotificationScheduleSettings(folders: [])
+    }
+    
+    public init(folders: [Folder]) {
+        self.folders = folders
+    }
+    
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: StringCodingKey.self)
+        
+        self.folders = try container.decodeIfPresent([Folder].self, forKey: "folders") ?? []
+    }
+    
+    public func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: StringCodingKey.self)
+        
+        try container.encode(self.folders, forKey: "folders")
+    }
+    
+    public func folder(id: Int32) -> Folder? {
+        return self.folders.first(where: { $0.id == id })
+    }
+    
+    public func withUpdatedEntry(folderId: Int32, entry: FolderNotificationScheduleEntry) -> ChatListFolderNotificationScheduleSettings {
+        var folders = self.folders
+        if let index = folders.firstIndex(where: { $0.id == folderId }) {
+            folders[index].entry = entry
+        } else {
+            folders.append(Folder(id: folderId, entry: entry))
+        }
+        return ChatListFolderNotificationScheduleSettings(folders: folders)
+    }
+    
+    public func activeFolderIds(at date: Date, calendar: Calendar) -> Set<Int32> {
+        var result = Set<Int32>()
+        for folder in self.folders where folder.entry.isActive(at: date, calendar: calendar) {
+            result.insert(folder.id)
+        }
+        return result
+    }
+}
+
+public func updateChatListFolderNotificationScheduleSettings(engine: TelegramEngine, _ f: @escaping (ChatListFolderNotificationScheduleSettings) -> ChatListFolderNotificationScheduleSettings) -> Signal<Never, NoError> {
+    return engine.preferences.update(id: ApplicationSpecificPreferencesKeys.chatListFolderNotificationSchedules, { entry in
+        let currentSettings: ChatListFolderNotificationScheduleSettings
+        if let entry = entry?.get(ChatListFolderNotificationScheduleSettings.self) {
+            currentSettings = entry
+        } else {
+            currentSettings = .default
+        }
+        return SharedPreferencesEntry(f(currentSettings))
+    })
+}
