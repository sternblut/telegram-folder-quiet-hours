+}
+
+public func _internal_chatListFiltersIncludePeer(transaction: Transaction, filterIds: Set<Int32>, peerId: PeerId, accountPeerId: PeerId) -> Bool {
+    let filters = _internal_currentChatListFilters(transaction: transaction).filter { filterIds.contains($0.id) }
+    guard !filters.isEmpty, let peer = transaction.getPeer(peerId) else {
+        return false
+    }
+    let isContact = transaction.isPeerContact(peerId: peer.notificationSettingsPeerId ?? peer.id)
+    let groupId = transaction.getPeerChatListIndex(peerId).flatMap { EngineChatList.Group($0.0) }
+    return ChatListFiltersInclusion(filters: filters, accountPeerId: accountPeerId).includes(peer: EnginePeer(peer), groupId: groupId, isContact: isContact)
+}
+
+public struct ChatListFiltersInclusion {
+    private let predicates: [ChatListFilterPredicate]
+    
+    public init(filters: [ChatListFilter], accountPeerId: EnginePeer.Id) {
+        self.predicates = filters.compactMap { filter -> ChatListFilterPredicate? in
+            guard case let .filter(_, _, _, data) = filter else {
+                return nil
+            }
+            var rules = data
+            rules.excludeMuted = false
+            rules.excludeRead = false
+            return chatListFilterPredicate(filter: rules, accountPeerId: accountPeerId)
+        }
+    }
+    
+    public var isEmpty: Bool {
+        return self.predicates.isEmpty
+    }
+    
+    public func includes(peer: EnginePeer, groupId: EngineChatList.Group?, isContact: Bool) -> Bool {
+        for predicate in self.predicates {
+            if predicate.pinnedPeerIds.contains(peer.id) {
+                return true
+            }
+            guard let groupId = groupId?._asGroup() else {
+                continue
+            }
+            if groupId != .root && !predicate.includeAdditionalPeerGroupIds.contains(groupId) {
+                continue
+            }
+            if predicate.includes(peer: peer._asPeer(), groupId: groupId, isRemovedFromTotalUnreadCount: false, isUnread: false, isContact: isContact, messageTagSummaryResult: nil) {
+                return true
+            }
+        }
+        return false
+    }
+}
