diff --git a/submodules/ChatListUI/Sources/FolderNotificationScheduleManager.swift b/submodules/ChatListUI/Sources/FolderNotificationScheduleManager.swift
new file mode 100644
index 00000000..adf41dc7
--- /dev/null
+++ b/submodules/ChatListUI/Sources/FolderNotificationScheduleManager.swift
@@ -0,0 +1,120 @@
+import Foundation
+import UIKit
+import SwiftSignalKit
+import TelegramCore
+import TelegramUIPreferences
+import FolderNotificationSchedule
+
+public final class FolderNotificationScheduleManager {
+    private let engine: TelegramEngine
+    private var cleanupDisposable: Disposable?
+    
+    public init(engine: TelegramEngine) {
+        self.engine = engine
+        
+        // Only after the folders have synced: an empty local list would drop every schedule.
+        self.cleanupDisposable = (combineLatest(
+            engine.peers.updatedChatListFiltersInfo(),
+            engine.data.subscribe(TelegramEngine.EngineData.Item.Configuration.ApplicationSpecificPreference(key: ApplicationSpecificPreferencesKeys.chatListFolderNotificationSchedules))
+        )
+        |> mapToSignal { filtersInfo, entry -> Signal<Never, NoError> in
+            let settings = entry?.get(ChatListFolderNotificationScheduleSettings.self) ?? .default
+            let existingFolderIds = Set(filtersInfo.filters.map(\.id))
+            if !filtersInfo.synchronized || settings.folders.allSatisfy({ existingFolderIds.contains($0.id) }) {
+                return .complete()
+            }
+            return updateChatListFolderNotificationScheduleSettings(engine: engine, { settings in
+                var settings = settings
+                settings.folders.removeAll(where: { !existingFolderIds.contains($0.id) })
+                return settings
+            })
+        }).startStrict()
+    }
+    
+    deinit {
+        self.cleanupDisposable?.dispose()
+    }
+    
+    public func isQuiet(peerId: EnginePeer.Id) -> Signal<Bool, NoError> {
+        let engine = self.engine
+        return engine.data.get(TelegramEngine.EngineData.Item.Configuration.ApplicationSpecificPreference(key: ApplicationSpecificPreferencesKeys.chatListFolderNotificationSchedules))
+        |> mapToSignal { entry -> Signal<Bool, NoError> in
+            let settings = entry?.get(ChatListFolderNotificationScheduleSettings.self) ?? .default
+            let activeFolderIds = settings.activeFolderIds(at: Date(), calendar: Calendar.current)
+            if activeFolderIds.isEmpty {
+                return .single(false)
+            }
+            return engine.peers.chatListFiltersIncludePeer(filterIds: activeFolderIds, peerId: peerId)
+        }
+    }
+}
+
+func folderNotificationScheduleActiveFolderIds(engine: TelegramEngine) -> Signal<Set<Int32>, NoError> {
+    return engine.data.subscribe(TelegramEngine.EngineData.Item.Configuration.ApplicationSpecificPreference(key: ApplicationSpecificPreferencesKeys.chatListFolderNotificationSchedules))
+    |> map { entry -> [Int32: FolderNotificationScheduleEntry] in
+        let settings = entry?.get(ChatListFolderNotificationScheduleSettings.self) ?? .default
+        var result: [Int32: FolderNotificationScheduleEntry] = [:]
+        for folder in settings.folders where folder.entry.isEnabled {
+            result[folder.id] = folder.entry
+        }
+        return result
+    }
+    |> distinctUntilChanged
+    |> mapToSignal { entries -> Signal<Set<Int32>, NoError> in
+        if entries.isEmpty {
+            return .single(Set())
+        }
+        // The timer counts uptime, which stops while the device sleeps.
+        return Signal { subscriber in
+            let queue = Queue.mainQueue()
+            let timer = Atomic<SwiftSignalKit.Timer?>(value: nil)
+            let isDisposed = Atomic<Bool>(value: false)
+            func update() {
+                if isDisposed.with({ $0 }) {
+                    return
+                }
+                let now = Date()
+                let calendar = Calendar.current
+                var active = Set<Int32>()
+                var nextCheck: Date?
+                for (id, entry) in entries {
+                    if entry.isActive(at: now, calendar: calendar) {
+                        active.insert(id)
+                    }
+                    if let transition = entry.nextTransition(after: now, calendar: calendar) {
+                        nextCheck = min(nextCheck ?? transition, transition)
+                    }
+                }
+                subscriber.putNext(active)
+                var newTimer: SwiftSignalKit.Timer?
+                if let nextCheck {
+                    newTimer = SwiftSignalKit.Timer(timeout: max(1.0, nextCheck.timeIntervalSinceNow + 1.0), repeat: false, completion: {
+                        update()
+                    }, queue: queue)
+                }
+                timer.swap(newTimer)?.invalidate()
+                newTimer?.start()
+            }
+            queue.async {
+                update()
+            }
+            let observers = [UIApplication.willEnterForegroundNotification, UIApplication.significantTimeChangeNotification, NSNotification.Name.NSSystemTimeZoneDidChange].map { name in
+                return NotificationCenter.default.addObserver(forName: name, object: nil, queue: nil, using: { _ in
+                    queue.async {
+                        update()
+                    }
+                })
+            }
+            return ActionDisposable {
+                queue.async {
+                    let _ = isDisposed.swap(true)
+                    timer.swap(nil)?.invalidate()
+                    for observer in observers {
+                        NotificationCenter.default.removeObserver(observer)
+                    }
+                }
+            }
+        }
+        |> distinctUntilChanged
+    }
+}
