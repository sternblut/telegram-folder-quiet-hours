@@ -0,0 +1,66 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramUIPreferences
+import AccountContext
+import UndoUI
+import TextFormat
+import FolderNotificationSchedule
+import FolderNotificationScheduleScreen
+
+extension ChatListControllerImpl {
+    func openFolderNotificationSchedule(filterId: Int32, title: ChatFolderTitle) {
+        let context = self.context
+        let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Configuration.ApplicationSpecificPreference(key: ApplicationSpecificPreferencesKeys.chatListFolderNotificationSchedules))
+        |> deliverOnMainQueue).startStandalone(next: { [weak self] entry in
+            guard let self else {
+                return
+            }
+            let settings = entry?.get(ChatListFolderNotificationScheduleSettings.self) ?? .default
+            let controller = FolderNotificationScheduleScreen(context: context, folderTitle: title, initialEntry: settings.folder(id: filterId)?.entry, completion: { [weak self] updatedEntry in
+                let _ = updateChatListFolderNotificationScheduleSettings(engine: context.engine, { settings in
+                    return settings.withUpdatedEntry(folderId: filterId, entry: updatedEntry)
+                }).startStandalone()
+                self?.presentFolderNotificationScheduleToast(title: title, entry: updatedEntry)
+            })
+            self.push(controller)
+        })
+    }
+    
+    private func presentFolderNotificationScheduleToast(title: ChatFolderTitle, entry: FolderNotificationScheduleEntry) {
+        let presentationData = self.presentationData
+        let template: String
+        let animation: String
+        let scale: CGFloat
+        let colors: [String: UIColor]
+        if let summary = folderNotificationScheduleSummary(entry, strings: presentationData.strings, dateTimeFormat: presentationData.dateTimeFormat) {
+            template = presentationData.strings.FolderQuietHours_ToastSet.replacingOccurrences(of: "{schedule}", with: summary)
+            animation = "anim_mute_for"
+            scale = 0.066
+            colors = [:]
+        } else {
+            template = presentationData.strings.FolderQuietHours_ToastOff
+            animation = "anim_profileunmute"
+            scale = 0.075
+            let iconColor: UIColor = .white
+            colors = [
+                "Middle.Group 1.Fill 1": iconColor,
+                "Top.Group 1.Fill 1": iconColor,
+                "Bottom.Group 1.Fill 1": iconColor,
+                "EXAMPLE.Group 1.Fill 1": iconColor,
+                "Line.Group 1.Stroke 1": iconColor
+            ]
+        }
+        let text = NSMutableAttributedString(string: template)
+        let folderNameRange = (text.string as NSString).range(of: "{folder}")
+        if folderNameRange.location != NSNotFound {
+            text.replaceCharacters(in: folderNameRange, with: "")
+            text.insert(title.attributedString(attributes: [
+                ChatTextInputAttributes.bold: true
+            ]), at: folderNameRange.location)
+        }
+        self.present(UndoOverlayController(presentationData: presentationData, content: .universalWithEntities(context: self.context, animation: animation, scale: scale, colors: colors, title: nil, text: text, animateEntities: title.enableAnimations, customUndoText: nil, timeout: nil), elevatedLayout: false, animateInAsReplacement: true, action: { _ in return false }), in: .current)
+    }
+}
